#include "paw.dtsi"
#include <dt-bindings/led/led.h>

/* ---- DYA Studio: Runtime Input Processor 的 include ------------------------
 * 这三行必须放在 `#include "paw.dtsi"` **之后**，不能挪到 paw.dtsi 顶部。
 *
 * 因为 <input/processors/runtime-input-processor.dtsi> 会
 *   #include <dt-bindings/zmk/keys.h>  -> modifiers.h -> #define RC(keycode)
 * 而 paw.dtsi 里的矩阵表用的是
 *   dt-bindings/zmk/matrix_transform.h -> #define RC(row, col)
 * 两个 RC 同名。上面那行 include 会先把 paw.dtsi 整个处理完（矩阵表已经展开成
 * 数字），之后 keys.h 再来重定义 RC 就没影响了。
 *
 * 反过来（放 paw.dtsi 顶部）会直接编译失败：
 *   error: macro "RC" passed 2 arguments, but takes just 1
 * —— 2026-10-02 那次 CI 就是栽在这里。
 *
 * 文件里后面那些节点都不再用矩阵的 RC(...)，所以是安全的。
 */
#include <dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>

/ { chosen {
        zmk,underglow = &led_strip;
    };
};

&kscan0 {
        col-gpios
                = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio0 03 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
                ;
};

&left_encoder {
    status = "okay";
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 7)>,
                    <NRF_PSEL(SPIM_MISO, 1, 7)>,
                    <NRF_PSEL(SPIM_SCK, 0, 24)>;
        };
    };
    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 7)>,
                    <NRF_PSEL(SPIM_MISO, 1, 7)>,
                    <NRF_PSEL(SPIM_SCK, 0, 24)>;
            low-power-enable;
        };
    };
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>,
                    <NRF_PSEL(SPIM_SCK, 0, 26)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 12)>,
                    <NRF_PSEL(SPIM_SCK, 0, 26)>;
            low-power-enable;
        };
    };
};

&spi2 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <200000>;
        irq-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};

nice_view_spi: &spi3 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};

lpm_view_spi: &spi3 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};

/* ---- DYA Studio: 中央侧（本半）轨迹球的 processor --------------------------
 * 左半自己的 PAW3222 走 trackball_listener 这条路径，processor 挂在这里。
 * 右半构建不会引用鼠标/滚动这两个默认 processor 节点，
 * 模块里它们是 /omit-if-no-ref/ 的，会被整个丢掉（省 RAM、也不会有重名 label）。
 */
&trackball_listener {
    input-processors = <&mouse_runtime_input_processor>;
};

/* ---- DYA Studio: 非中央侧（右半）的轨迹球经 split 送来，在这里挂 processor ----
 * 右半的 PAW3222 是通过 &pmw_split { device = <&trackball>; } 直接把
 * 传感器事件转发到中央侧的，绕过了 input-listener，所以在右半的
 * trackball_listener 上挂 processor 对这条流不生效。
 * 要让 DYA Studio 能调右半轨迹球，必须在中央侧的 pmw_listener 上挂。
 *
 * 注意：这里刻意用独立的 processor 节点（而不是共用
 * mouse_runtime_input_processor），避免两条事件流共用同一份
 * scale/inertia/axis-snap 状态，也让 Studio 里两个 processor 能分别调。
 *
 * processor-label 在 binding 里是 **required**（zmk,input-processor-runtime），
 * 且类型说明写着 "max 8 chars for BLE compatibility"。
 * 这里取 6 个字符 tsplit，避免 8 字符是否含结尾符 NUL 的歧义。
 */
/ {
    trackball_split_runtime_input_processor: trackball_split_runtime_input_processor {
        compatible = "zmk,input-processor-runtime";
        processor-label = "tsplit";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        scale-multiplier = <1>;
        scale-divisor = <1>;
        rotation-degrees = <0>;
        track-remainders;

        /* 与模块自带的默认节点保持一致，这样 temp-layer（用轨迹球自动切层）
         * 在 DYA Studio 里打开时行为和 mouse_runtime_input_processor 一样 */
        temp-layer-transparent-behavior = <&trans>;
        temp-layer-kp-behavior = <&kp>;
        temp-layer-keep-keycodes = <LEFT_CONTROL LEFT_SHIFT LEFT_ALT LEFT_GUI RIGHT_CONTROL RIGHT_SHIFT RIGHT_ALT RIGHT_GUI>;

        #input-processor-cells = <0>;
    };
};

&pmw_listener {
    status = "okay";
    input-processors = <&trackball_split_runtime_input_processor>;
};

&left_listener {
    device = <&trackball>;
};

/ {
    led_strip: ws2812 {
        compatible = "worldsemi,ws2812-gpio";
        gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
        chain-length = <28>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&adc {
    status = "okay";
};

/* battery-fix (AIN3):
 * 恢复外部分压测量，并把通道改成正确的 AIN2。
 *
 * 硬件（见原理图）：SW_OUT --[R2 806k]-- battery_adc_pin --[R3 2M]-- GND
 *   分压比 = R3/(R2+R3) = 2000000/2806000 = 0.7126
 *   3.78V 电池 -> 分压点约 2.69V
 *   所以 output-ohms 必须是 R3，full-ohms 必须是 R2+R3：
 *       output-ohms = <2000000>;
 *       full-ohms   = <2806000>;
 *
 * 之前的两处错误：
 *   1) io-channels = <&adc 12> —— 12 是芯片【内部】的 VDDH/5 通道。
 *      这块板子的 VDDH 是稳压过的 ~3.3V，代入 ZMK 的百分比公式
 *      (mv*2/15-459) 得到负数 -> 百分比恒为 0。
 *   2) 曾改成 zmk,battery-nrf-vddh（直接测 VDDH）—— 同样是测错了地方。
 *
 * 现在改成 AIN3 = P0.05（nice!nano v1 的电池脚；这块板子的分压电阻值
 * 与 v1 完全一致，说明是照 v1 的电路画的）。
 *
 * 若读数仍不合理，把 &adc 3 换成 &adc 2（AIN2 = P0.04），
 * 它是这块板子上唯一另一个空闲的模拟脚。
 */

/ {
    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 3>;
        output-ohms = <2000000>;
        full-ohms = <2806000>;
    };
};
