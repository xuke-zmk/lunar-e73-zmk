#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/keys.h>

#include <dt-bindings/zmk/pointing.h>

#include <dt-bindings/zmk/outputs.h>



/ {

    keymap {

        compatible = "zmk,keymap";



        default_layer {

            display-name = "Default Layer";



            bindings = <

&kp TAB    &kp Q  &out OUT_TOG     &kp E     &kp R  &kp T          &kp Y    &kp U  &kp I      &kp O     &kp P     &kp BSPC

&kp LCTRL  &kp A  &kp S     &kp D     &kp F  &kp G          &kp H    &kp J  &kp K      &kp L     &kp SEMI  &kp SQT

&kp LSHFT  &kp Z  &kp X     &kp C     &kp V  &kp B          &kp N    &kp M  &kp COMMA  &kp DOT   &kp FSLH  &kp ESC

                  &kp LGUI  &kp LGUI  &mo 1  &kp SPACE      &kp RET  &mo 2  &kp RALT   &kp LGUI

            >;



            sensor-bindings =

                <&inc_dec_kp C_VOL_UP C_VOL_DN>,

                <&inc_dec_kp PG_UP PG_DN>;

        };



        lower_layer {

            display-name = "Lower Layer";



            bindings = <

&studio_unlock  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5            &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC

&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans

&kp LSHFT   &trans        &trans        &trans        &trans        &trans            &trans    &trans    &trans    &trans     &trans  &trans

                          &kp LGUI      &kp LGUI      &trans        &kp SPACE         &kp RET   &trans    &kp RALT  &kp LGUI

            >;

        };

    };

